# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign user authentication tokens.
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION"

# MTN Mobile Money API (Collection & Disbursement)
MTN_MOMO_ENV="sandbox"
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_SUBSCRIPTION_KEY=""

# Orange Money WebPay / Merchant API
ORANGE_MONEY_ENV="sandbox"
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_KEY=""

# International Card Gateway (Visa / Mastercard)
CARD_GATEWAY_PROVIDER="stripe"
CARD_GATEWAY_SECRET_KEY=""
